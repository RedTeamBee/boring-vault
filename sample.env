OPTIMISM_RPC_URL=https://optimism-mainnet.infura.io/v3/{YOUR_INFURA_KEY}
ZIRCUIT_RPC_URL=https://zircuit1-mainnet.p2pify.com
SCROLL_RPC_URL=https://rpc.scroll.io
LINEA_RPC_URL=https://linea-mainnet.infura.io/v3/{YOUR_INFURA_KEY}
